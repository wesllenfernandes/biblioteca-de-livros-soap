    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="cadastrar_categoriaResponse">
    <xs:sequence>
      <xs:element name="cadastrar_categoriaResult" type="tns:Categoria" minOccurs="0" nillable="true"/>
