    xmlns:tns="http://exemplo.com/catalogocursos"
    targetNamespace="http://exemplo.com/catalogocursos"
    elementFormDefault="qualified">
  <xs:complexType name="Categoria">
    <xs:sequence>
      <xs:element name="id" type="xs:integer" minOccurs="0" nillable="true"/>
      <xs:element name="nome" type="xs:string" minOccurs="0" nillable="true"/>
      <xs:element name="descricao" type="xs:string" minOccurs="0" nillable="true"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Curso">
