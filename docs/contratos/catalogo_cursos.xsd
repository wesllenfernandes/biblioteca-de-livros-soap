  <xs:element name="consultar_categoria" type="tns:consultar_categoria"/>
  <xs:element name="consultar_categoriaResponse" type="tns:consultar_categoriaResponse"/>
  <xs:element name="cadastrar_categoria" type="tns:cadastrar_categoria"/>
